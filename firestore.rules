rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // username -> uid lookup (public pages resolve through this)
    match /usernames/{name} {
      allow get: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && name.matches('^[a-z0-9_.]{3,24}$');
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid;

      // Owner can edit anything; visitors may only bump `views` by exactly 1.
      allow update: if (request.auth != null && request.auth.uid == uid)
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
                        && request.resource.data.views == resource.data.views + 1);

      // Anonymous analytics events: anyone may append a well-formed event, only the owner can read them.
      match /events/{eventId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.resource.data.keys().hasOnly(['type', 'linkId', 'ts', 'day', 'ref', 'device', 'country'])
                      && request.resource.data.type in ['view', 'click']
                      && request.resource.data.device in ['mobile', 'tablet', 'desktop']
                      && request.resource.data.ts is number
                      && request.resource.data.day is string && request.resource.data.day.size() == 10
                      && request.resource.data.ref is string && request.resource.data.ref.size() <= 60
                      && request.resource.data.country is string && request.resource.data.country.size() <= 2;
      }

      match /links/{linkId} {
        allow read: if true;
        allow create, delete: if request.auth != null && request.auth.uid == uid;

        // Owner can edit anything; visitors may only bump `clicks` by exactly 1.
        allow update: if (request.auth != null && request.auth.uid == uid)
                      || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks'])
                          && request.resource.data.clicks == resource.data.clicks + 1);
      }
    }
  }
}
